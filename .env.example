# Copier ce fichier en .env et renseigner les valeurs reelles. Ne jamais committer .env.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de donnees Django (dev = sqlite, prod = postgres://user:password@host:port/dbname)
DATABASE_URL=sqlite:///db.sqlite3

# Email (SMTP interne PAMF - notifications, activation de compte)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=mail.pamf.mg
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@pamf.mg
SITE_BASE_URL=http://localhost:8000

# Base CBS (SQL Server, PAMF) - lecture seule
CBS_DB_SERVER=172.20.24.37
CBS_DB_NAME=CBS
CBS_DB_UID=
CBS_DB_PWD=
